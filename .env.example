# =====================================================================
# LUMEN CONFIGURATION (.env.example)
# Copy this file to .env before starting the application.
# Never commit real API keys or secrets to version control.
# =====================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# Application Security & Database
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-min-32-chars
KEY_ENCRYPTION_SECRET=change-this-in-production-to-a-secure-aes256-encryption-key-min-32-chars
DATABASE_URL=sqlite:///./data/lumen.db
DATA_DIR=./data
MAX_UPLOAD_MB=100

# Authentication & Tokens
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Caching
CACHE_TTL_SECONDS=3600

# =====================================================================
# SHARED SERVER LLM PROVIDER POOL (Fallback Chain)
# =====================================================================
LLM_PROVIDER=groq
LLM_FALLBACK_ORDER=groq,zai,huggingface
SHARED_POOL_HOURLY_LIMIT=30

# 1. Groq Multi-Key Pool (Round-Robin & Automatic Cooldown)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=

# 2. Z.AI (GLM-4)
ZAI_API_KEY=
ZAI_MODEL=glm-4

# 3. Hugging Face Inference API
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Frontend Port (default: 80; use 3000 on Windows if port 80 is reserved)
FRONTEND_PORT=80

# Public contact intake (messages are stored even when SMTP is unset)
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
