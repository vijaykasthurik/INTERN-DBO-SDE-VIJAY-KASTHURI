# =====================================================================
# LUMEN CONFIGURATION (.env.example)
# Copy this file to .env before starting the application.
# Never commit real API keys or secrets to version control.
# =====================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# Application Security & Database
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-min-32-chars
DATABASE_URL=sqlite:///./data/lumen.db
DATA_DIR=./data
MAX_UPLOAD_MB=50

# Authentication & Tokens
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Caching
CACHE_TTL_SECONDS=3600

# =====================================================================
# LLM PROVIDER SETTINGS
# LLM_PROVIDER specifies primary provider: mock, gemini, groq, openrouter, openai_compat
# LLM_FALLBACK_ORDER specifies priority list for router failover
# Default is 'mock' which requires NO API keys and runs completely offline.
# =====================================================================
LLM_PROVIDER=mock
LLM_FALLBACK_ORDER=mock,gemini,groq,openrouter,openai_compat

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_STRONG=gemini-2.0-flash-thinking-exp-01-21

# Groq
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.3-70b-versatile
GROQ_MODEL_STRONG=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=google/gemini-2.0-flash-001
OPENROUTER_MODEL_STRONG=anthropic/claude-3.5-sonnet

# OpenAI-Compatible Endpoint (Local or alternative cloud)
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_FAST=gpt-4o-mini
OPENAI_COMPAT_MODEL_STRONG=gpt-4o
